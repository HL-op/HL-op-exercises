//在任意位置p之后，插入一个新元素x
void insert(int p, int x) {
	id++;
	e[id] = x;
	mp[x] = id;

	ne[id] = ne[p];
	ne[p] = id;

}


int main() {

	for (int i = 1; i <= 5; i++) {
		push_front(i);
		print();
	}
	//cout << find(1) << endl;
