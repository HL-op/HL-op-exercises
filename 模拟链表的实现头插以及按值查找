#include<iostream>
using namespace std;
const int N = 1e6 + 10;
int e[N], ne[N], id, h;//e[i]表示第i个节点的值，ne[i]表示第i个节点的next指针，id表示当前已经使用的节点数量，h表示头节点的位置
int mp[N];	//mp[i]表示i这个数存储的位置 

void print() {//打印链表
	for (int i = ne[h]; i; i = ne[i]) {
		cout << e[i] << " ";
	}
	cout << endl << endl;
}
//头插法
void push_front(int x) {
	id++;
	e[id] = x;
	mp[x] = id;//记录x这个数存储的位置

	ne[id] = ne[h];//新节点的next指向原来h的next
	ne[h] = id;//h的next指向新节点
}
