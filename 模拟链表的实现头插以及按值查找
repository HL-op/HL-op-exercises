int find_1(int x) {
	//解法二：用mp数组优化
	return mp[x];

}

int main() {

	for (int i = 1; i <= 5; i++) {
		push_front(i);
		print();
	}
	//cout << find(1) << endl;
	cout << find_1(1) << endl;

	return 0;
}
