#include<iostream>
#include<queue>
using namespace std;
using PII = pair<int, int>;	//或者typedef pair<int,int> PII

int main() {

	queue<PII> q;	// 定义一个队列对象 q，用于存储 PII (pair<int, int>) 类型的元素
	for (int i = 1; i <= 10; i++) {
		q.push({ i,i * 10 });// 将一个二元组 {i, i*10} 入队，作为队列的新队尾元素
	}

	while (q.size()) {			// 当队列不为空时，循环处理所有元素
		auto t = q.front();		// 获取队首元素，并赋值给变量 t
		q.pop();				// 移除队首元素，使下一个元素成为新的队首
			
		cout << t.first << " " << t.second << endl;//输出二元组t的两个成员值
	}

	return 0;
}
